---
/**
 * Long-form page (Privacy, Terms, How we calculate), laid out like a chapter book: a giant
 * Inter Tight title on the offset grid with a thin ember reading line along the top, "at a
 * glance" as a dark band of numbered tiles, then a sticky rail (the chapter you're in, as a big
 * ember number, over the contents) beside numbered chapters, closing on a big question.
 *
 * Usage:
 *   <DocLayout title=… sections={[{ id: 'collect', title: 'What we collect' }, …]} glance={[…]}>
 *     <section id="collect" data-doc-section> … </section>
 *   </DocLayout>
 * The contents list is built from `sections`, so it can't drift from the page.
 * An optional `slot="band"` section (e.g. a dark key-figures band) sits between
 * "at a glance" and the contents.
 * The editorial look is scoped to `.doc-ed` in src/styles/doc.css, so the other
 * pages that import doc.css (FAQ, start pages, pricing…) are unaffected.
 */
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/doc.css';

interface Glance { icon: string; title: string; text: string; }
interface Props {
  title: string;            // <title>
  heading: string;          // on-page h1
  accent?: string;          // the rest of the heading, on its own line in ember (.hp-ember)
  eyebrow: string;
  lead: string;
  description: string;
  path: string;
  updated: string;
  readMins: number;
  sections: { id: string; title: string }[];
  glance?: Glance[];
  glanceNote?: string;
}
const { title, heading, accent, eyebrow, lead, description, path, updated, readMins, sections, glance, glanceNote } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title={title} description={description} path={path}>
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <main id="main" class="hp is-new doc-ed">
  <div class="doc-read-line" aria-hidden="true"></div>
  <header class="hp-hero doc-ed-hero">
    <div class="hp-wrap doc-ed-hero-grid">
      <p class="doc-ed-micro num">{eyebrow}<br/>Updated {updated}<br/>{readMins} min read · {sections.length} parts</p>
      <h1 class="doc-ed-title">{heading}{accent && <> <span class="hp-ember">{accent}</span></>}</h1>
      <p class="hp-lead doc-ed-lead">{lead}</p>
    </div>
  </header>

  {glance && (
    <section class="doc-night doc-ed-glance" aria-labelledby="glance-title">
      <div class="hp-wrap">
        <div class="doc-night-head">
          <h2 id="glance-title" class="doc-night-title">At a glance</h2>
          {glanceNote && <p class="doc-night-note">{glanceNote}</p>}
        </div>
        <ul class="doc-tiles">
          {glance.map((g, i) => (
            <li class="doc-tile">
              <span class="doc-tile-n" aria-hidden="true">{num(i)}</span>
              <strong class="doc-tile-t">{g.title}</strong>
              <span class="doc-tile-d">{g.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <slot name="band"/>

  <section class="hp-sec doc-ed-main">
  <div class="hp-wrap doc-ed-grid">
    <nav class="doc-toc" aria-label="On this page">
      <details class="doc-toc-mobile">
        <summary>On this page <Icon name="chevron" size={14} stroke={2.2}/></summary>
        <ol>{sections.map((s, i) => <li><a href={`#${s.id}`}><span class="doc-toc-num">{num(i)}</span>{s.title}</a></li>)}</ol>
      </details>
      <div class="doc-toc-desktop">
        <p class="doc-rail-num num" aria-hidden="true" id="docRailNum">01</p>
        <p class="doc-toc-label">On this page</p>
        <ol>{sections.map((s, i) => <li><a href={`#${s.id}`} data-toc={s.id}><span class="doc-toc-num">{num(i)}</span>{s.title}</a></li>)}</ol>
      </div>
    </nav>

    <article class="doc-content">
      <slot/>
      <aside class="doc-contact doc-ed-contact">
        <div>
          <h2>Still have a question?</h2>
          <p>FirePath is built by one person in Australia. Email and you'll get a real reply, usually within a day.</p>
        </div>
        <a href="mailto:hello@firepath.pro" class="doc-btn">Email hello@firepath.pro</a>
      </aside>
    </article>
  </div>
  </section>

  </main>
  <script>
    import { followSections } from '../scripts/toc';
    followSections();
    // The rail's big number follows whichever chapter is current.
    const railNum = document.getElementById('docRailNum');
    const tocList = document.querySelector('.doc-toc-desktop ol');
    if (railNum && tocList) {
      const show = () => { const n = tocList.querySelector('a[aria-current] .doc-toc-num'); if (n && railNum.textContent !== n.textContent) railNum.textContent = n.textContent; };
      new MutationObserver(show).observe(tocList, { subtree: true, attributes: true, attributeFilter: ['aria-current'] });
      show();
    }
    // Close the phone contents menu after choosing a section.
    document.querySelectorAll('.doc-toc-mobile a').forEach(a => a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
  </script>
</Base>
