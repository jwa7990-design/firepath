---
/**
 * Base page: the <head> every FirePath page shares (analytics, fonts, design
 * tokens) and the body attributes js/shell.js reads to draw the navigation.
 * Pages still in public/ carry their own copy of this; new pages use this one.
 */
interface Props {
  title: string;
  description?: string;
  path: string;                 // e.g. "/privacy" — used for the canonical and og:url
  shell?: 'site' | 'app';
  active?: string;              // highlighted nav item (see js/shell.js)
  footer?: boolean;
  ogType?: 'website' | 'article';
  keywords?: string | null;
  image?: string;               // share image path, 1200×630 (default /og/default.png)
  noindex?: boolean;            // keep this page out of search results
}
const { title, description, path, shell = 'site', active, footer = true, ogType = 'website', keywords, image = '/og/default.png', noindex = false } = Astro.props;
const url = new URL(path, 'https://www.firepath.pro').href;
const imageUrl = new URL(image, 'https://www.firepath.pro').href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q2QZ662MJ9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-Q2QZ662MJ9', Object.assign({
      // Privacy: send only the page's address, never what follows it (a question typed
      // into Ask FirePath, a sign-in link's code), and keep Google's ad features off.
      page_location: location.origin + location.pathname,
      allow_google_signals: false,
      allow_ad_personalization_signals: false
    }, document.referrer ? { page_referrer: document.referrer.split(/[?#]/)[0] } : {}));
  </script>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>{title}</title>
  {description && <meta name="description" content={description}/>}
  <link rel="canonical" href={url}/>
  <meta property="og:title" content={title}/>
  {description && <meta property="og:description" content={description}/>}
  <meta property="og:url" content={url}/>
  <meta property="og:type" content={ogType}/>
  <meta property="og:site_name" content="FirePath"/>
  <meta property="og:locale" content="en_AU"/>
  <meta property="og:image" content={imageUrl}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:image" content={imageUrl}/>
  {keywords && <meta name="keywords" content={keywords}/>}
  {noindex && <meta name="robots" content="noindex"/>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32"/>
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
  <link rel="manifest" href="/site.webmanifest"/>
  <meta name="theme-color" content="#FDF6EE"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
  <script is:inline src="/js/persona.js"></script>
  <slot name="head"/>
</head>
<body class={shell} data-shell={shell} data-active={active} data-footer={footer ? undefined : 'none'}>
<script is:inline src="/js/shell.js"></script>
<slot/>
</body>
</html>
