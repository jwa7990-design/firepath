---
/**
 * "Start where you are" landing pages (/start/<slug>), built from src/data/starts.ts.
 * Each one is also a search landing page: a focused title and description, FAQ and
 * breadcrumb structured data, and links into the right free tools and articles.
 */
import Base from '../../layouts/Base.astro';
import { STARTS, type StartPage } from '../../data/starts';
import { ARTICLES } from '../../lib/learn';
import '../../styles/marketing.css';
import '../../styles/start.css';
import MiniPath from '../../components/MiniPath.astro';

export function getStaticPaths() {
  return STARTS.map(p => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page: p } = Astro.props as { page: StartPage };
const reads = p.articles.map(s => ARTICLES.find(a => a.slug === s)).filter(Boolean);
const others = STARTS.filter(x => x.slug !== p.slug);
// Hierarchy: each step shows its first sentence; the rest (and its link) sits behind "More".
// Links to the free calculator are dropped from the steps: the page's one button already goes there.
const firstSentence = (t: string): [string, string] => {
  const m = t.match(/^(.+?[.!?][”’]?)\s+(?=[A-Z“‘])([\s\S]*)$/);
  return m ? [m[1], m[2]] : [t, ''];
};
const steps = p.steps.map(s => {
  const [line, rest] = firstSentence(s.body);
  const link = s.href && !/^\/firepath(\b|$)/.test(s.href) ? { href: s.href, cta: s.cta } : null;
  return { title: s.title, line, rest, link };
});
const TOP = 3;
const readsTop = reads.slice(0, TOP), readsRest = reads.slice(TOP);
const url = `https://www.firepath.pro/start/${p.slug}`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'FirePath', item: 'https://www.firepath.pro/' },
    { '@type': 'ListItem', position: 2, name: p.door, item: url } ] },
];
---
<Base title={p.seoTitle} description={p.description} path={`/start/${p.slug}`} image={`/og/start/${p.slug}.png`}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
  {/* Shared editorial primitives. Loads before the page CSS (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <main id="main" class="hp">
    <header class="hp-hero">
      <div class="hp-wrap start-hero">
        <div>
          <p class="hp-label mk-kicker">{p.door}</p>
          <h1 class="hp-h1 mk-h1-wide">{p.title}</h1>
          <p class="hp-lead">{p.lead}</p>
          <div class="mk-actions">
            <a href="/firepath" class="mk-btn">Find my freedom date</a>
            <span class="mk-aside">Free, 2 minutes, no account needed. See what could make the biggest difference.</span>
          </div>
        </div>
        <MiniPath class="start-motif"/>
      </div>
    </header>

    <section class="hp-sec start-steps-sec" aria-labelledby="steps-title">
      <div class="hp-wrap hp-side">
        <div class="hp-side-head">
          <h2 id="steps-title" class="hp-h2 is-mid">A common way to approach it</h2>
        </div>
        <ol class="hp-side-main mk-steps start-steps start-steps-tight">
          {steps.map((s, i) => (
            <li class="mk-step" data-reveal>
              <span class="mk-step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{s.title}</h3>
                <p class="start-step-line">{s.line}</p>
                {s.rest ? (
                  <details class="hp-more start-step-more">
                    <summary>More<span class="hp-sr"> on “{s.title}”</span></summary>
                    <p class="hp-l3">{s.rest}</p>
                    {s.link && <a href={s.link.href} class="hp-link">{s.link.cta} →</a>}
                  </details>
                ) : s.link && <a href={s.link.href} class="hp-link start-step-link">{s.link.cta} →</a>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="hp-sec is-sand start-res" aria-label="Free tools and reading">
      <div class="hp-wrap start-res-grid">
        <div class="start-res-col start-tools">
          <div class="start-res-head">
            <h2 id="tools-title" class="hp-h2 is-mid">Free tools for this</h2>
            <p class="hp-body is-ink start-free"><span class="hp-mark is-ink" aria-hidden="true"></span>Free · no account</p>
          </div>
          <ul class="start-list hp-rows" aria-labelledby="tools-title">
            {p.tools.map(t => (
              <li><a href={t.href} class="start-item">
                <span class="start-item-title">{t.name}</span>
                <span class="start-item-meta">{t.line}</span>
                <span class="start-item-go hp-go" aria-hidden="true">→</span>
              </a></li>
            ))}
          </ul>
        </div>
        <div class="start-res-col">
          <div class="start-res-head">
            <h2 id="reads-title" class="hp-h2 is-mid">Read next</h2>
          </div>
          <ul class="start-list hp-rows" aria-labelledby="reads-title">
            {readsTop.map(a => a && (
              <li><a href={`/learn/${a.slug}`} class="start-item" title={a.description}>
                <span class="start-item-title">{a.heading}</span>
                <span class="start-item-meta num">{a.readMins} min read</span>
              </a></li>
            ))}
          </ul>
          {readsRest.length > 0 && (
            <details class="hp-more start-reads-more">
              <summary>Show all {reads.length}</summary>
              <ul class="start-list hp-rows">
                {readsRest.map(a => a && (
                  <li><a href={`/learn/${a.slug}`} class="start-item" title={a.description}>
                    <span class="start-item-title">{a.heading}</span>
                    <span class="start-item-meta num">{a.readMins} min read</span>
                  </a></li>
                ))}
              </ul>
            </details>
          )}
        </div>
      </div>
    </section>

    <section class="hp-sec" aria-labelledby="faq-title">
      <div class="hp-wrap hp-side">
        <div class="hp-side-head">
          <h2 id="faq-title" class="hp-h2 is-mid">Straight answers</h2>
        </div>
        <div class="hp-side-main mk-qs start-qs">
          {p.faq.map(f => (
            <details class="mk-q">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-sec is-dark start-end" aria-labelledby="end-title">
      <div class="hp-wrap">
        <div class="mk-close">
          <div>
            <h2 id="end-title" class="hp-h2 start-end-title">What would matter most for you?</h2>
            <p class="hp-body">The free calculator shows which of these matter most for you, and by how many years.</p>
          </div>
          <div class="mk-actions"><a href="/firepath" class="mk-btn">Find my freedom date</a></div>
        </div>
        <nav class="start-also" aria-labelledby="others-title">
          <h2 id="others-title" class="start-also-label">Not quite you?</h2>
          <ul class="hp-inline-links">
            {others.map(o => <li><a href={`/start/${o.slug}`}>{o.door}</a></li>)}
          </ul>
        </nav>
        <p class="mk-note">FirePath is educational, not financial advice. Rules and figures are Australian and current for {new Date().getFullYear()}.</p>
      </div>
    </section>
  </main>
</Base>
