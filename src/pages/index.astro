---
/**
 * Homepage. The freedom date and the path to it are the brand, so the page opens on a
 * live calculator (src/components/FreedomPath.astro + public/js/home-path.js, using the
 * shared engine), then five short sections, Jay's letter and the "Start where you are"
 * doors. Jay's letter comes word for word from src/data/letter.ts.
 */
import Base from '../layouts/Base.astro';
import FreedomPath from '../components/FreedomPath.astro';
import { LETTER, HOME_DESCRIPTION } from '../data/letter';
import { ARTICLES, FIRST_READS, type Article } from '../lib/learn';
import { STARTS } from '../data/starts';
import { PRO_PRICE, TRIAL_FINE_PRINT } from '../data/plans';
import '../styles/home-path.css';

const firstReads = FIRST_READS.map(s => ARTICLES.find(a => a.slug === s)).filter((a): a is Article => !!a);
const TOOLS = [
  { href: '/withdrawal', name: 'Withdrawal planner', line: 'See if your money will last, across 2,000 possible market outcomes.' },
  { href: '/hearmeout', name: 'What if…?', line: 'Sell the house, a lump sum, redundancy, downsizing, rent vs invest.' },
  { href: '/freedom-gap', name: 'Freedom gap', line: 'What part-time work and the Age Pension could add.' },
  { href: '/compound', name: 'Compound interest', line: 'What regular saving grows into.' },
];
---
<Base title="Money shouldn’t feel confusing | FirePath" description={HOME_DESCRIPTION} path="/">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify([
    { '@context': 'https://schema.org', '@type': 'Organization', name: 'FirePath', url: 'https://www.firepath.pro/', logo: 'https://www.firepath.pro/icons/icon-512.png', email: 'hello@firepath.pro', areaServed: 'AU' },
    { '@context': 'https://schema.org', '@type': 'WebSite', name: 'FirePath', url: 'https://www.firepath.pro/', inLanguage: 'en-AU' },
  ])}></script>
  <main id="main" class="hp">

    <!-- Hero: the live freedom path -->
    <header class="hp-hero">
      <div class="hp-wrap">
        <div class="hp-hero-head">
          <h1 class="hp-h1">When could you stop working?</h1>
          <p class="hp-lead">Type a few numbers. See the year work becomes optional, and the path to get there. Free, Australian, no account needed.</p>
        </div>
        <FreedomPath/>
      </div>
    </header>

    <!-- 01 Find your number: the one dark band -->
    <section class="hp-number" aria-labelledby="s1-title">
      <div class="hp-wrap hp-number-grid" data-reveal>
        <p class="hp-num">01</p>
        <div class="hp-number-copy">
          <h2 id="s1-title" class="hp-h2">Find your number</h2>
          <p class="hp-number-big num"><span data-hp-number>$1,250,000</span></p>
          <p class="hp-number-sum num">25 × <span data-hp-spend>$50,000</span> a year</p>
        </div>
        <p class="hp-number-text">Your freedom number is about 25 times what you spend in a year. Drawn down slowly, about 4% a year, that amount has lasted 30 years or more in most past markets. It counts your savings and your super together, and it moves with the spending you type in above.</p>
      </div>
    </section>

    <!-- 02 See your path: editorial two columns with a small path sketch -->
    <section class="hp-sec" aria-labelledby="s2-title">
      <div class="hp-wrap hp-two" data-reveal>
        <div>
          <p class="hp-num">02</p>
          <h2 id="s2-title" class="hp-h2">See your path</h2>
          <p class="hp-body">In Australia most people can’t get to their super until 60. So if you stop work earlier, the money you hold outside super pays the way until then. That’s the bridge.</p>
          <p class="hp-body">From 60 your super joins in and takes over. FirePath checks both parts: that your savings last until 60, and that savings and super together are enough after that.</p>
          <a href="/learn/two-phase-freedom-timeline" class="hp-link">How the two parts work →</a>
        </div>
        <figure class="hp-sketch" aria-label="A path from today, to the day work becomes optional, to 60 when super can be used">
          <svg viewBox="0 0 340 130" role="img" aria-hidden="true" focusable="false">
            <line class="hp-seg is-work" x1="10" x2="130" y1="70" y2="70"/>
            <line class="hp-seg is-bridge" x1="130" x2="262" y1="70" y2="70"/>
            <line class="hp-seg is-after" x1="262" x2="332" y1="70" y2="70"/>
            <line class="hp-sixty" x1="262" x2="262" y1="61" y2="79"/>
            <circle class="hp-today-dot" cx="10" cy="70" r="4.5"/>
            <line class="hp-stem" x1="130" x2="130" y1="40" y2="62"/>
            <circle class="hp-free-dot" cx="130" cy="70" r="7"/>
            <text class="hp-lab is-free" x="130" y="32" text-anchor="middle">Work optional</text>
            <text class="hp-lab is-small" x="196" y="61" text-anchor="middle">savings carry you</text>
            <text class="hp-lab" x="4" y="98">Today</text>
            <text class="hp-lab" x="262" y="98" text-anchor="middle">60</text>
            <text class="hp-lab is-small" x="298" y="61" text-anchor="middle">super</text>
          </svg>
          <figcaption>Savings first, then super from 60.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 03 Change the variables: tools as a ruled list -->
    <section class="hp-sec" aria-labelledby="s3-title">
      <div class="hp-wrap hp-side" data-reveal>
        <div class="hp-side-head">
          <p class="hp-num">03</p>
          <h2 id="s3-title" class="hp-h2">Change the variables</h2>
          <p class="hp-body">Free tools for the questions that come next. No account needed.</p>
        </div>
        <ul class="hp-rules">
          {TOOLS.map(t => (
            <li><a href={t.href} class="hp-rule">
              <span class="hp-rule-name">{t.name}</span>
              <span class="hp-rule-line">{t.line}</span>
              <span class="hp-rule-go" aria-hidden="true">→</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 04 Understand why: the Learning Lab as an editorial list -->
    <section class="hp-sec" aria-labelledby="s4-title">
      <div class="hp-wrap" data-reveal>
        <div class="hp-learn-head">
          <div>
            <p class="hp-num">04</p>
            <h2 id="s4-title" class="hp-h2">Understand why</h2>
          </div>
          <p class="hp-body">{ARTICLES.length} short guides in the Learning Lab, in plain English. Start with these three.</p>
        </div>
        <ol class="hp-reads">
          {firstReads.map(a => (
            <li><a href={`/learn/${a.slug}`} class="hp-read">
              <span class="hp-read-title">{a.heading}</span>
              <span class="hp-read-meta num">{a.readMins} min read</span>
            </a></li>
          ))}
        </ol>
        <a href="/learn/" class="hp-link">Browse the Learning Lab →</a>
      </div>
    </section>

    <!-- 05 Keep moving: Pro, understated -->
    <section class="hp-sec hp-pro" aria-labelledby="s5-title">
      <div class="hp-wrap hp-pro-grid" data-reveal>
        <div>
          <p class="hp-num">05</p>
          <h2 id="s5-title" class="hp-h2">Keep moving</h2>
        </div>
        <div>
          <p class="hp-body">Get to know your numbers free, no account needed. When you want FirePath to keep up with you, Pro saves your plan, lays out your options, shows your progress since last time, and lets you Ask FirePath about your own numbers.</p>
          <p class="hp-pro-price num"><strong>{PRO_PRICE.amount} a month</strong> after a {PRO_PRICE.trialDays}-day free trial.</p>
          <p class="hp-pro-fine">{TRIAL_FINE_PRINT}</p>
          <p class="hp-pro-links"><a href="/upgrade" class="hp-link">Try Pro free for {PRO_PRICE.trialDays} days →</a><a href="/pricing" class="hp-link is-quiet">Compare plans</a></p>
        </div>
      </div>
    </section>

    <!-- Jay's letter -->
    <section class="hp-sec hp-letter" id="why" aria-labelledby="letter-title">
      <div class="hp-wrap hp-letter-grid" data-reveal>
        <div class="hp-photo">
          {/* TODO(owner): replace this block with Jay's photo, e.g.
              <img src="/images/jay.jpg" alt="Jay, founder of FirePath" width="480" height="600" loading="lazy"/> */}
          <div class="hp-photo-slot" role="img" aria-label="Photo of Jay coming soon"><span>Photo coming</span></div>
        </div>
        <div class="hp-letter-copy">
          <h2 id="letter-title" class="hp-label">Why I built this</h2>
          <blockquote class="hp-quote">{LETTER.opener}</blockquote>
          <div class="hp-letter-body">
            {LETTER.paragraphs.map(p => <p set:html={p}/>)}
          </div>
          <p class="hp-sig">
            <span>Thanks for stopping by.</span>
            <strong>— {LETTER.name}</strong>
            <span>{LETTER.role}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Start where you are -->
    <section class="hp-sec hp-doors" aria-labelledby="doors-title">
      <div class="hp-wrap hp-side" data-reveal>
        <div class="hp-side-head">
          <h2 id="doors-title" class="hp-h2 is-small">Start where you are</h2>
          <p class="hp-body">A plain plan for where you’re at.</p>
        </div>
        <ul class="hp-rules">
          {STARTS.map(d => (
            <li><a href={`/start/${d.slug}`} class="hp-rule">
              <span class="hp-rule-name">{d.door}</span>
              <span class="hp-rule-line">{d.doorLine}</span>
              <span class="hp-rule-go" aria-hidden="true">→</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <script is:inline src="/js/tax-engine.js"></script>
  <script is:inline src="/js/calculations.js"></script>
  <script is:inline src="/js/financial-engine.js"></script>
  <script is:inline src="/js/home-path.js"></script>
</Base>
