---
/**
 * Homepage. The freedom date and the path to it are the brand, so the page opens on a
 * live calculator (src/components/FreedomPath.astro + public/js/home-path.js, using the
 * shared engine), then four calm sections: the timeline, where to start, free vs Pro and
 * Jay's letter. One picture, one job per screen; everything else lives on its own page.
 * Jay's letter comes word for word from src/data/letter.ts.
 */
import Base from '../layouts/Base.astro';
import FreedomPath from '../components/FreedomPath.astro';
import AusLap from '../components/AusLap.astro';
import HeroOutline from '../components/HeroOutline.astro';
import { LETTER, HOME_DESCRIPTION } from '../data/letter';
import { ARTICLES, FIRST_READS } from '../lib/learn';
import { STARTS } from '../data/starts';
import { PRO_PRICE, TRIAL_FINE_PRINT } from '../data/plans';
import '../styles/home-path.css';

// What Pro adds, in one line (the full lists live on /pricing and /features, from plans.ts).
// Phase 2 statements, split into words so they can light up one by one as they scroll through.
const CHAPTER = ['Money', 'shouldn’t', 'feel', 'confusing.'];
const OPENER = LETTER.opener.replace(/^["“]+|["”]+$/g, '').split(' ');
const PRO_ADDS = 'your full plan with super, tax worked out and an AI read on it';
// A few first guides for under the timeline (the bridge guide is already linked there).
const READS = FIRST_READS.filter(s => s !== 'two-phase-freedom-timeline').map(s => ARTICLES.find(a => a.slug === s)).filter(a => !!a);
const TOOLS = [
  { href: '/withdrawal', name: 'Withdrawal planner' },
  { href: '/hearmeout', name: 'What if…?' },
  { href: '/freedom-gap', name: 'Freedom gap' },
  { href: '/compound', name: 'Compound interest' },
  { href: '/retirement-age-calculator', name: 'Retirement age calculator' },
];
---
<Base title="FirePath: Retirement & FIRE Planner for Australians" description={HOME_DESCRIPTION} path="/">
  <link slot="head" rel="stylesheet" href="/css/freedom-path.css"/>
  {/* Shared editorial primitives. Loads before home-path.css (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify([
    { '@context': 'https://schema.org', '@type': 'Organization', name: 'FirePath', url: 'https://www.firepath.pro/', logo: 'https://www.firepath.pro/icons/icon-512.png', email: 'hello@firepath.pro', areaServed: 'AU' },
    { '@context': 'https://schema.org', '@type': 'WebSite', name: 'FirePath', url: 'https://www.firepath.pro/', inLanguage: 'en-AU' },
  ])}></script>
  <main id="main" class="hp is-home">

    <!-- Hero: big type over Australia's coastline burning round like a fuse in the background; then the fuse draws a bow
         and the calculator rises into it.
         Wide screens with motion allowed: the stage pins briefly and scrolling carries the line further. -->
    <header class="hp-hero is-home is-lap">
      <div class="hp-scene" id="hpScene">
        <div class="hp-scene-stage">
          <HeroOutline/>
          <!-- Wide screens: once the coast has closed, the spark leaves Darwin, climbs, and splits into two
               that draw a bow across the screen for the calculator to rise into (home-path.js draws it) -->
          <svg class="hp-bow" id="hpBow" aria-hidden="true" focusable="false">
            <path class="hp-bow-line" id="hpBowRise" pathLength="1"/>
            <path class="hp-bow-line" id="hpBowL" pathLength="1"/>
            <path class="hp-bow-line" id="hpBowR" pathLength="1"/>
            <circle class="hp-bow-spark" id="hpBowS1" r="4.5"/>
            <circle class="hp-bow-spark" id="hpBowS2" r="4.5"/>
          </svg>
          <div class="hp-wrap hp-hero-grid">
            <p class="hp-micro">Money tools<br/>in plain<br/>English.</p>
            <h1 class="hp-h1">From here to a <span class="hp-ember">freer future.</span></h1>
            <div class="hp-hero-side">
              <p class="hp-lead">See how today’s decisions could shape your future, and when work could become optional.</p>
              <p class="hp-hero-act"><a href="#hpCalc" class="hp-btn" id="hpFind">Find my path <span aria-hidden="true">→</span></a></p>
              <p class="hp-assure"><span class="hp-nw">Takes about 2 minutes</span><span aria-hidden="true">·</span><span class="hp-nw">Free to use</span><span aria-hidden="true">·</span><span class="hp-nw">No signup needed</span></p>
            </div>
          </div>
        </div>
      </div>
      <div class="hp-wrap">
        <FreedomPath/>
      </div>
    </header>

    <!-- Chapter line: big words that light up one by one as they scroll through (CSS); elsewhere they simply show -->
    <div class="hp-chapter">
      <div class="hp-wrap">
        <p class="hp-chapter-line">{CHAPTER.map((w, i) => <>{i > 0 && ' '}<span class="hp-w" style={`--i:${i}`}>{w}</span></>)}</p>
      </div>
    </div>

    <section class="hp-sec hp-story" aria-labelledby="s1b-title">
      <div class="hp-wrap" data-reveal>
        <div class="hp-tl-intro">
        <div class="hp-tl-head">
          <h2 id="s1b-title" class="hp-h2">Your path, step by step</h2>
          <p class="hp-body">Your numbers from above, laid out as a path: where you are today, when work could become optional, and how super joins in from 60. Ages are to scale. The line shows time, not money, and figures are estimates in today’s dollars.</p>
        </div>
          <div class="hp-tl-lap"><AusLap/></div>
        </div>
        <figure class="hp-story-fig" id="hpStory">
          <svg class="hp-story-svg" id="hpStorySvg" aria-hidden="true" focusable="false" width="100%" height="200"></svg>
          <figcaption class="hp-story-cap fpv-sr" id="hpStoryCap">Your path draws here from the numbers in the calculator above.</figcaption>
        </figure>
        <ol class="hp-stages" id="hpStages" aria-label="Your path, stage by stage"></ol>
        <p class="hp-tl-links"><a href="/learn/two-phase-freedom-timeline" class="hp-link">How the two parts work →</a></p>
        <p class="hp-more">Worth a read: {READS.map((a, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={`/learn/${a!.slug}`}>{a!.heading}</a></>)}<span aria-hidden="true"> · </span><a href="/learn/">all {ARTICLES.length} guides</a></p>
      </div>
    </section>

    <!-- 03 Improve: questions worth looking into next, and Pro (free vs Pro from plans.ts, an example of Your plan) -->
    <!-- Start where you are: five tall cards. Wide screens: the section pins and scrolling slides them sideways
         (home-path.js switches it on); elsewhere they're a row you can swipe. -->
    <section class="hp-sec hp-doors hp-deck" id="hpDeck" aria-labelledby="s3-title">
      <div class="hp-deck-pin">
        <div class="hp-wrap hp-deck-head">
          <h2 id="s3-title" class="hp-h2">Start where you are</h2>
          <p class="hp-body">Options people look into, and the next question worth asking, wherever you’re at.</p>
        </div>
        <div class="hp-deck-view">
          <ol class="hp-deck-track" id="hpDeckTrack">
            {STARTS.map((d, i) => (
              <li class="hp-deck-item"><a href={`/start/${d.slug}`} class="hp-card">
                <span class="hp-card-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="hp-card-t">{d.door}</span>
                <span class="hp-card-d">{d.doorLine}</span>
                <span class="hp-card-go" aria-hidden="true">→</span>
              </a></li>
            ))}
          </ol>
        </div>
        <div class="hp-wrap">
          <p class="hp-more">More free tools: {TOOLS.map((t, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={t.href}>{t.name}</a></>)}</p>
        </div>
      </div>
    </section>

    <section class="hp-sec hp-pro" aria-labelledby="s3b-title">
      <div class="hp-wrap" data-reveal>
        <div>
          <h2 id="s3b-title" class="hp-h2">Free to explore. Pro when you want it to keep up.</h2>
          <p class="hp-body hp-pro-sum">Get to know your numbers free, no account needed. Pro (<strong>{PRO_PRICE.amount} a month</strong> after a {PRO_PRICE.trialDays}-day free trial, cancel any time) saves your plan and adds {PRO_ADDS}.</p>
          <p class="hp-pro-fine">{TRIAL_FINE_PRINT}</p>
          <p class="hp-pro-links"><a href="/upgrade" class="hp-link">Try Pro free for {PRO_PRICE.trialDays} days →</a><a href="/pricing" class="hp-link is-quiet">Compare plans</a></p>
        </div>
      </div>
    </section>

    <!-- Jay's letter -->
    <section class="hp-sec hp-letter" id="why" aria-labelledby="letter-title">
      <div class="hp-wrap">
        <h2 id="letter-title" class="hp-label">Why I built this</h2>
        {/* Jay's opener, word for word, as the closing statement; the words light up as it scrolls through */}
        <blockquote class="hp-manifesto">{OPENER.map((w, i) => <>{i > 0 && ' '}<span class="hp-w" style={`--i:${i}`}>{w}</span></>)}</blockquote>
      </div>
      <div class="hp-wrap hp-letter-grid" data-reveal>
        {/* No photo by choice: the letter is the feature. A real person, in his own words. */}
        <aside class="hp-letter-side" aria-label="About the founder">
          <dl class="hp-facts">
            <div><dt>Who</dt><dd>{LETTER.name}, founder</dd></div>
            <div><dt>Day job</dt><dd>Support worker</dd></div>
            <div><dt>Where</dt><dd>Mid North Coast, NSW</dd></div>
            <div><dt>Say hello</dt><dd><a href="mailto:hello@firepath.pro">hello@firepath.pro</a></dd></div>
          </dl>
        </aside>
        <div class="hp-letter-copy">
          <div class="hp-letter-body">
            {LETTER.paragraphs.map(p => <p set:html={p}/>)}
          </div>
          <p class="hp-sig">
            <span>Thanks for stopping by.</span>
            <strong>— {LETTER.name}</strong>
            <span>{LETTER.role}</span>
          </p>
          <p class="hp-trust"><a href="/assumptions">How we calculate</a><span aria-hidden="true"> · </span><a href="/faq#q-accurate">How accurate is FirePath?</a><span aria-hidden="true"> · </span><a href="/faq">FAQ</a></p>
        </div>
      </div>
    </section>

  </main>

  <script is:inline src="/js/tax-engine.js"></script>
  <script is:inline src="/js/calculations.js"></script>
  <script is:inline src="/js/financial-engine.js"></script>
  <script is:inline src="/js/freedom-path.js"></script>
  <script is:inline src="/js/home-path.js"></script>
</Base>
