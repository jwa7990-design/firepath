---
/**
 * Homepage. The freedom date and the path to it are the brand, so the page opens on a
 * live calculator (src/components/FreedomPath.astro + public/js/home-path.js, using the
 * shared engine), then three sections (01 Understand, 02 Explore, 03 Improve) and Jay's
 * letter. Jay's letter comes word for word from src/data/letter.ts.
 */
import Base from '../layouts/Base.astro';
import FreedomPath from '../components/FreedomPath.astro';
import { LETTER, HOME_DESCRIPTION } from '../data/letter';
import { ARTICLES, FIRST_READS, type Article } from '../lib/learn';
import { STARTS } from '../data/starts';
import { PRO_PRICE, TRIAL_FINE_PRINT, FREE_FEATURES, PRO_FEATURES } from '../data/plans';
import '../styles/home-path.css';

// Free vs Pro, short: straight from plans.ts (the single source), first lines only.
const FREE_SHORT = [FREE_FEATURES[0], FREE_FEATURES[1], FREE_FEATURES[4], 'The Withdrawal planner, Freedom gap and Compound interest', FREE_FEATURES[8]];
const PRO_SHORT = PRO_FEATURES.slice(0, 6).map(([title]) => title);
const firstReads = FIRST_READS.map(s => ARTICLES.find(a => a.slug === s)).filter((a): a is Article => !!a);
const TOOLS = [
  { href: '/withdrawal', name: 'Withdrawal planner', line: 'See if your money could last, across 2,000 possible market outcomes.' },
  { href: '/hearmeout', name: 'What if…?', line: 'Sell the house, a lump sum, redundancy, downsizing, rent vs invest.' },
  { href: '/freedom-gap', name: 'Freedom gap', line: 'What part-time work and the Age Pension could add.' },
  { href: '/compound', name: 'Compound interest', line: 'What regular saving grows into.' },
];
// Section 03's live what-ifs. public/js/home-path.js works each one out on the hero's numbers.
const SCENARIOS = [
  { key: 'windfall', name: 'A $20,000 windfall invested', href: '/hearmeout?scenario=lump', go: 'What if…?' },
  { key: 'yearoff', name: 'Taking a year off at no saving', href: '/hearmeout', go: 'What if…?' },
  { key: 'spendless', name: 'Spending $5,000 a year less', href: '/firepath', go: 'Find my freedom date' },
];
---
<Base title="FirePath: Retirement & FIRE Planner for Australians" description={HOME_DESCRIPTION} path="/">
  <link slot="head" rel="stylesheet" href="/css/freedom-path.css"/>
  {/* Shared editorial primitives. Loads before home-path.css (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify([
    { '@context': 'https://schema.org', '@type': 'Organization', name: 'FirePath', url: 'https://www.firepath.pro/', logo: 'https://www.firepath.pro/icons/icon-512.png', email: 'hello@firepath.pro', areaServed: 'AU' },
    { '@context': 'https://schema.org', '@type': 'WebSite', name: 'FirePath', url: 'https://www.firepath.pro/', inLanguage: 'en-AU' },
  ])}></script>
  <main id="main" class="hp is-home">

    <!-- Hero: the brand line, then the live freedom path (inputs left, result panel right) -->
    <header class="hp-hero is-home">
      <div class="hp-wrap">
        <FreedomPath>
          <div slot="intro" class="hp-hero-head">
            <h1 class="hp-h1">Money shouldn’t feel confusing.</h1>
            <p class="hp-lead">FirePath helps everyday Australians make sense of saving, super, tax and investing, in plain English.</p>
          </div>
        </FreedomPath>
      </div>
    </header>

    <!-- 01 Understand: your number (the one dark band), then why 60 matters with the Learning Lab picks -->
    <section class="hp-number" aria-labelledby="s1-title">
      <div class="hp-wrap hp-number-grid" data-reveal>
        <p class="hp-num">01 · Understand</p>
        <div class="hp-number-copy">
          <h2 id="s1-title" class="hp-h2">Your freedom number</h2>
          <p class="hp-number-big num"><span data-hp-number>$1,250,000</span></p>
          <p class="hp-number-sum num">25 × <span data-hp-spend>$50,000</span> a year</p>
          <div class="hp-slide">
            <label for="hpSpendSlide">Move your yearly spending</label>
            <input type="range" id="hpSpendSlide" min="30000" max="150000" step="1000" value="50000" aria-valuetext="$50,000 a year"/>
            <div class="hp-slide-scale num" aria-hidden="true"><span>$30k</span><span>$150k</span></div>
          </div>
        </div>
        <div class="hp-number-text">
          <p>About 25 times what you spend in a year. Drawn down slowly, about 4% a year, that has lasted 30 years or more in most past markets. Stopping before 60 means it has to last longer, so FirePath plans on a little more then.</p>
          <p class="hp-number-rule num">Every $1,000 a year less spending lowers it by $25,000.</p>
        </div>
      </div>
    </section>

    <section class="hp-sec hp-story" aria-labelledby="s1b-title">
      <div class="hp-wrap hp-two" data-reveal>
        <div>
          <h2 id="s1b-title" class="hp-h2">Why 60 matters</h2>
          <p class="hp-body">Most Australians can’t get to their super until 60. Stop earlier, and the money you hold outside super pays the way until then. That’s the bridge. From 60 your super joins in, and FirePath checks both parts.</p>
          <a href="/learn/two-phase-freedom-timeline" class="hp-link">How the two parts work →</a>
        </div>
        <figure class="hp-story-fig" id="hpStory">
          <p class="hp-fig-tag" id="hpStoryTag">Your path, from the numbers above</p>
          <svg class="hp-story-svg" id="hpStorySvg" aria-hidden="true" focusable="false" width="100%" height="360"></svg>
          <figcaption class="hp-story-cap" id="hpStoryCap">On the example numbers, work could become optional at 50. Your savings carry you about 10 years to 60, then your super takes over.</figcaption>
        </figure>
        <div class="hp-reads-box">
          <p class="hp-fig-tag">Make sense of it: {ARTICLES.length} short guides in the Learning Lab</p>
          <ol class="hp-reads is-compact">
            {firstReads.map(a => (
              <li><a href={`/learn/${a.slug}`} class="hp-read">
                <span class="hp-read-title">{a.heading}</span>
                <span class="hp-read-meta num">{a.readMins} min read</span>
              </a></li>
            ))}
          </ol>
          <a href="/learn/" class="hp-link">Browse the Learning Lab →</a>
        </div>
      </div>
    </section>

    <!-- 02 Explore: three live what-ifs on the visitor's numbers, the spread of possible futures, then the tools -->
    <section class="hp-sec hp-explore" aria-labelledby="s2-title">
      <div class="hp-wrap hp-side" data-reveal>
        <div class="hp-side-head">
          <p class="hp-num">02 · Explore</p>
          <h2 id="s2-title" class="hp-h2">Change the variables</h2>
          <p class="hp-body">Things that happen in real life, worked out on the numbers above. No account needed.</p>
        </div>
        <div class="hp-side-main">
          <p class="hp-fig-tag">On your numbers <span class="num" id="hpScenNow"></span></p>
          <ul class="hp-scens" id="hpScens">
            {SCENARIOS.map(sc => (
              <li><a href={sc.href} class="hp-scen" data-scen={sc.key}>
                <span class="hp-scen-name">{sc.name}</span>
                <span class="hp-scen-out num"><span aria-hidden="true">→ </span><span data-out>–</span></span>
                <span class="hp-scen-meta"><span data-delta></span><span class="hp-scen-go">{sc.go} →</span></span>
              </a></li>
            ))}
          </ul>
          <p class="hp-scen-note" id="hpScenNote">General information only. The year off pauses saving for 12 months while what you already have keeps growing.</p>
        </div>
      </div>
      <div class="hp-wrap" data-reveal>
        <figure class="hp-fut" id="hpFut">
          <div class="hp-fut-head">
            <p class="hp-fut-title num">2,000 possible futures</p>
            <p class="hp-fut-sub" id="hpFutSub">Markets go up and down, so FirePath shows a likely range, not just one year. When work could become optional on your numbers, in a sample of 100 market outcomes. Each dot is one outcome.</p>
          </div>
          <svg class="hp-fut-svg" id="hpFutSvg" aria-hidden="true" focusable="false" width="100%" height="180"></svg>
          <figcaption class="hp-fut-cap num" id="hpFutCap" aria-live="polite"></figcaption>
        </figure>
        <div class="hp-tools">
          <p class="hp-fig-tag is-tools">Tools for the questions that come next</p>
          <ul class="hp-rules">
            {TOOLS.map(t => (
              <li><a href={t.href} class="hp-rule">
                <span class="hp-rule-name">{t.name}</span>
                <span class="hp-rule-line">{t.line}</span>
                <span class="hp-rule-go" aria-hidden="true">→</span>
              </a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 Improve: questions worth looking into next, and Pro (free vs Pro from plans.ts, an example of Your plan) -->
    <section class="hp-sec hp-doors" aria-labelledby="s3-title">
      <div class="hp-wrap hp-side" data-reveal>
        <div class="hp-side-head">
          <p class="hp-num">03 · Improve</p>
          <h2 id="s3-title" class="hp-h2">Start where you are</h2>
          <p class="hp-body">Options people look into, and the next question worth asking, wherever you’re at.</p>
        </div>
        <ul class="hp-rules">
          {STARTS.map(d => (
            <li><a href={`/start/${d.slug}`} class="hp-rule">
              <span class="hp-rule-name">{d.door}</span>
              <span class="hp-rule-line">{d.doorLine}</span>
              <span class="hp-rule-go" aria-hidden="true">→</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="hp-sec hp-pro" aria-labelledby="s3b-title">
      <div class="hp-wrap hp-pro-grid" data-reveal>
        <div>
          <h2 id="s3b-title" class="hp-h2">Free to explore. Pro when you want it to keep up.</h2>
          <div class="hp-plans">
            <div>
              <p class="hp-plans-head">Free, no account</p>
              <ul class="hp-plans-list">{FREE_SHORT.map(f => <li>{f}</li>)}</ul>
            </div>
            <div>
              <p class="hp-plans-head">Pro adds</p>
              <ul class="hp-plans-list">{PRO_SHORT.map(f => <li>{f}</li>)}</ul>
            </div>
          </div>
          <p class="hp-pro-price num"><strong>{PRO_PRICE.amount} a month</strong> after a {PRO_PRICE.trialDays}-day free trial. Cancel any time.</p>
          <p class="hp-pro-fine">{TRIAL_FINE_PRINT}</p>
          <p class="hp-pro-links"><a href="/upgrade" class="hp-link">Try Pro free for {PRO_PRICE.trialDays} days →</a><a href="/pricing" class="hp-link is-quiet">Compare plans</a></p>
        </div>
        <figure class="hp-plan" data-hp-once aria-label="Example of Your plan (Pro), with made-up numbers">
          <figcaption class="hp-fig-tag">Example of Your plan (Pro), made-up numbers</figcaption>
          <div class="hp-plan-card">
            <div class="hp-plan-head">
              <span class="hp-plan-title">Your plan</span>
              <span class="hp-plan-count num">2 of 5 done</span>
            </div>
            <div class="hp-plan-bar" aria-hidden="true"><span></span></div>
            <ul class="hp-plan-rows">
              <li><span>Having a three-month cash buffer</span><span class="hp-plan-st is-done">Done</span></li>
              <li><span>Saving a little more each week</span><span class="hp-plan-st is-doing">On it</span></li>
            </ul>
            <p class="hp-plan-moved num">Since March your date moved 8 months closer.</p>
          </div>
        </figure>
      </div>
    </section>

    <!-- Jay's letter -->
    <section class="hp-sec hp-letter" id="why" aria-labelledby="letter-title">
      <div class="hp-wrap hp-letter-grid" data-reveal>
        {/* No photo by choice: the letter is the feature. A real person, in his own words. */}
        <aside class="hp-letter-side" aria-label="About the founder">
          <dl class="hp-facts">
            <div><dt>Who</dt><dd>{LETTER.name}, founder</dd></div>
            <div><dt>Day job</dt><dd>Support worker</dd></div>
            <div><dt>Where</dt><dd>Mid North Coast, NSW</dd></div>
            <div><dt>Say hello</dt><dd><a href="mailto:hello@firepath.pro">hello@firepath.pro</a></dd></div>
          </dl>
        </aside>
        <div class="hp-letter-copy">
          <h2 id="letter-title" class="hp-label">Why I built this</h2>
          <span class="hp-quote-mark" aria-hidden="true">&ldquo;</span>
          <blockquote class="hp-quote">{LETTER.opener.replace(/^["“]+|["”]+$/g, '')}</blockquote>
          <div class="hp-letter-body">
            {LETTER.paragraphs.map(p => <p set:html={p}/>)}
          </div>
          <p class="hp-sig">
            <span>Thanks for stopping by.</span>
            <strong>— {LETTER.name}</strong>
            <span>{LETTER.role}</span>
          </p>
        </div>
      </div>
    </section>

  </main>

  <script is:inline src="/js/tax-engine.js"></script>
  <script is:inline src="/js/calculations.js"></script>
  <script is:inline src="/js/financial-engine.js"></script>
  <script is:inline src="/js/freedom-path.js"></script>
  <script is:inline src="/js/home-path.js"></script>
</Base>
