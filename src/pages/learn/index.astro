---
/**
 * Learning Lab hub (/learn/). Built from the article collection (src/lib/learn.ts),
 * so it can only ever list articles that exist — add an article and it appears here.
 * Opens on a dashboard of tiles that float a little above the page (src/styles/learn-board.css):
 * search, how much there is, what you've read and where to pick up (this device only,
 * src/scripts/lab-progress.ts), suggestions from your calculator numbers, and one tile per shelf.
 * The full library of shelves follows below it.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import GuideTile from '../../components/GuideTile.astro';
import { ARTICLES, FIRST_READS, SHELVES, shelve, type Article } from '../../lib/learn';
import '../../styles/doc.css';
import '../../styles/learn-hub.css';
import '../../styles/learn-recs.css';
import '../../styles/learn-board.css';

const shelves = shelve();
const firstReads = FIRST_READS.map(s => ARTICLES.find(a => a.slug === s)).filter((a): a is Article => !!a);
const totalMins = ARTICLES.reduce((n, a) => n + a.readMins, 0);
// For the dashboard's progress (worked out in the browser from what's been read on this device)
const labData = {
  s: shelves.map(sh => ({ id: sh.id, slugs: [...sh.articles, ...sh.themes.flatMap(t => t.articles)].map(a => a.slug) })),
  t: Object.fromEntries(ARTICLES.map(a => [a.slug, [a.heading, a.readMins]])),
};
// "Guides related to the numbers you entered" fill-ins, by situation (after the person's own move articles).
const theme = (title: string) => SHELVES.find(s => s.id === 'questions')?.themes?.find(t => t.title === title)?.slugs || [];
const retirementReads = ['four-percent-rule-australia', 'is-my-super-enough', 'before-super-access'];
const recThemes = {
  debt: ['debt-vs-invest'],
  starting: theme('Where you stand'),
  building: [...theme('Time and freedom'), ...theme('What if…')],
  close: retirementReads,
  free: retirementReads,
  renting: theme('Home and renting'),
  fallback: [...theme('Where you stand'), ...FIRST_READS],
};
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'FirePath Learning Lab',
  url: 'https://www.firepath.pro/learn/',
  hasPart: ARTICLES.map(a => ({ '@type': 'Article', headline: a.heading, url: `https://www.firepath.pro/learn/${a.slug}` })),
};
---
<Base
  title="Learning Lab: plain-English money guides for Australians | FirePath"
  description="Free plain-English guides for Australians: how FIRE works, how to invest, where super fits, and how to work out your freedom number."
  path="/learn/"
  active="learn"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>

  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <main id="main" class="hp is-new hub-page">
    <div class="hub" id="hub">
      <!-- The dashboard: tiles floating a little above the page -->
      <section class="lab-board" aria-labelledby="labTitle">
        <div class="hp-wrap">
          <div class="lab-plane" id="labPlane">
            <div class="lab-head">
              <div>
                <h1 class="lab-title" id="labTitle">Learning <span class="hp-ember">Lab</span></h1>
                <p class="lab-lead">Money, explained in plain English. Free guides to financial independence for everyday Australians, from the basics of FIRE to super, investing and tax. No jargon, no sales pitch.</p>
              </div>
              <div class="lab-tile lab-search lab-z2">
                <Icon name="search" size={18}/>
                <input id="hubSearch" type="search" placeholder={`Search ${ARTICLES.length} guides…`} aria-label="Search the Learning Lab" autocomplete="off"/>
                <span class="hub-search-count" id="hubCount" aria-live="polite"></span>
              </div>
            </div>

            <div class="lab-stats" data-hub-hide-on-search>
              <div class="lab-tile lab-z1">
                <p class="lab-k">Guides</p>
                <p class="lab-n num">{ARTICLES.length}</p>
                <p class="lab-sub num">{Math.round(totalMins / 60)} hours of reading · Australian rules</p>
              </div>
              <div class="lab-tile lab-z2">
                <p class="lab-k">You’ve read</p>
                <p class="lab-n is-ember num" id="labReadN">0</p>
                <p class="lab-sub" id="labReadSub">Kept on this device only. Start anywhere.</p>
              </div>
              <!-- Until a guide has been opened on this device: the calculator; after that, where to pick up -->
              <a class="lab-tile lab-last lab-z3" id="labLast" href="/firepath">
                <p class="lab-k" id="labLastK">Try it on your numbers</p>
                <p class="lab-last-t" id="labLastT">Find the year work could become optional</p>
                <p class="lab-sub" id="labLastSub">Free · about 2 minutes · no account →</p>
              </a>
            </div>

            <!-- Filled in the browser from the numbers saved by the free calculator (this device only). -->
            <div class="lab-tile lab-recs lab-z2" id="hubRecs" hidden>
              <div class="lab-tile-head">
                <h2 id="recs-title" class="lab-k is-ember">Guides on topics in your numbers</h2>
                <p class="hub-recs-note">Topics that relate to the numbers you entered in the calculator. Not a ranking or a recommendation · <a href="#" id="hubRecsClear">Clear</a></p>
              </div>
              <ul class="lab-list" id="hubRecsList"></ul>
            </div>

            <div class="lab-tile lab-first lab-z2" data-hub-hide-on-search>
              <div class="lab-tile-head"><h2 id="first-title" class="lab-k is-ember">New here? Three places to begin</h2></div>
              <ol class="lab-list">
                {firstReads.map((a, i) => (
                  <li><a href={`/learn/${a.slug}`} class="hub-first-card">
                    <span class="hub-first-num">{i + 1}</span>
                    <span class="hub-first-text"><strong>{a.heading}</strong><span>{a.readMins} min read</span></span>
                    <Icon name="arrow" size={18}/>
                  </a></li>
                ))}
              </ol>
            </div>

            <ul class="lab-shelves" data-hub-hide-on-search aria-label="Shelves">
              {shelves.map(sh => (
                <li><a class="lab-tile lab-shelf lab-z1" href={`/learn/shelf/${sh.id}`} data-shelf={sh.id}>
                  <span class="lab-shelf-t">{sh.title}</span>
                  <span class="lab-sub"><span class="num">{sh.count}</span> guides<span data-shelf-read></span></span>
                  <span class="lab-bar" aria-hidden="true"><i data-shelf-bar></i></span>
                </a></li>
              ))}
            </ul>
          </div>
        </div>
      </section>
      <script type="application/json" id="labData" is:inline set:html={JSON.stringify(labData)}></script>

      {shelves.map((s, si) => (
        <section class:list={['hp-sec hub-shelf', si % 2 === 0 && 'is-sand']} id={s.id} aria-labelledby={`${s.id}-title`} data-hub-shelf>
          <div class="hp-wrap hp-side">
            <div class="hp-side-head">
              <h2 id={`${s.id}-title`} class="hp-h2 is-small">{s.title}</h2>
              <p class="hp-body">{s.intro}</p>
              <p class="hub-shelf-count num">{s.count} guides</p>
              <p class="hub-shelf-open"><a href={`/learn/shelf/${s.id}`} class="hp-link">Open the {s.title} shelf →</a></p>
            </div>
            <div class="hp-side-main">
              {s.articles.length > 0 && (
                <ul class="lab-guides">{s.articles.map((a, i) => <GuideTile a={a} n={i + 1}/>)}</ul>
              )}
              {s.themes.map(t => (
                <div class="hub-theme" data-hub-theme>
                  <h3>{t.title}</h3>
                  <ul class="lab-guides">{t.articles.map((a, i) => <GuideTile a={a} n={i + 1}/>)}</ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      ))}

      <div class="hp-wrap">
        <div class="hub-empty" id="hubEmpty" hidden>
          <strong>No guides match that yet.</strong>
          <p>Try a different word, or <a href="/feedback">tell us what you'd like explained</a>.</p>
        </div>
      </div>

      <section class="hp-sec hub-cta" aria-labelledby="hub-cta-title">
        <div class="hp-wrap hp-half">
          <h2 id="hub-cta-title" class="hp-h2">Put it to work on your own numbers</h2>
          <div>
            <p class="hp-body">Find the year work could become optional. Free, about 2 minutes, no account needed.</p>
            <p class="hub-cta-go"><a href="/firepath" class="doc-btn">Find my freedom date</a></p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline src="/js/tax-engine.js"></script>
  <script is:inline src="/js/calculations.js"></script>
  <script is:inline src="/js/financial-engine.js"></script>
  <script is:inline src="/js/moves.js"></script>
  <script is:inline define:vars={{ recThemes }}>
    // "Worth exploring": only when the free calculator saved numbers on this device
    // (FirePathMoves.recall). Never sent anywhere. Articles that don't fit are never shown.
    (function () {
      const M = window.FirePathMoves;
      const saved = M && M.recall();
      const hub = document.getElementById('hub');
      const shelf = document.getElementById('hubRecs');
      const list = document.getElementById('hubRecsList');
      if (!saved || !hub || !shelf || !list) return;
      const esc = v => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
      let s, moves;
      try { const r = M.rank(M.situationFromInputs(saved), { limit: 3 }); s = r.situation; moves = r.moves; } catch (e) { return; }
      // Topics in the standard order first, then debt, then renting and their stage (retirement reads lead once close).
      const stageReads = recThemes[s.stage] || [];
      const rentReads = s.housing === 'renting' ? recThemes.renting : [];
      const late = s.stage === 'close' || s.stage === 'free';
      const wanted = moves.map(m => m.article).filter(Boolean)
        .concat(s.consumerDebt > 0 ? recThemes.debt : [])
        .concat(late ? stageReads.concat(rentReads) : rentReads.concat(stageReads))
        .concat(recThemes.fallback);
      fetch('/learn/articles.json').then(r => r.ok ? r.json() : null).then(all => {
        if (!Array.isArray(all)) return;
        const bySlug = new Map(all.map(a => [a.slug, a]));
        const picks = [];
        for (const slug of wanted) {
          const a = bySlug.get(slug);
          if (a && !picks.includes(a) && M.articleFits(a.for, s)) picks.push(a);
          if (picks.length === 4) break;
        }
        if (!picks.length) return;
        list.innerHTML = picks.map(a => `<li><a href="/learn/${esc(a.slug)}" class="hub-first-card" data-rec="${esc(a.slug)}">`
          + `<span class="hub-first-num" aria-hidden="true">•</span>`
          + `<span class="hub-first-text"><strong>${esc(a.heading)}</strong><span>${esc(a.readMins)} min read</span></span>${arrow}</a></li>`).join('');
        shelf.hidden = false;
        hub.classList.add('has-recs');
        const search = document.getElementById('hubSearch');
        if (search) search.addEventListener('input', () => { shelf.hidden = !hub.classList.contains('has-recs') || !!search.value.trim(); });
      }).catch(() => {});
      const clear = document.getElementById('hubRecsClear');
      if (clear) clear.addEventListener('click', e => { e.preventDefault(); M.forget(); shelf.hidden = true; hub.classList.remove('has-recs'); });
    })();
  </script>

  <script>
    // The dashboard: what's been read on this device, where to pick up, progress per shelf, ticks on read
    // guides; and on wide screens with a mouse, the board leans very slightly towards the pointer.
    import { getRead, getLast } from '../../scripts/lab-progress';
    import { tickRead, leanBoard } from '../../scripts/lab-board';
    const data = JSON.parse(document.getElementById('labData')?.textContent || '{"s":[],"t":{}}') as { s: { id: string; slugs: string[] }[]; t: Record<string, [string, number]> };
    const read = new Set(getRead().filter(x => data.t[x]));
    const total = Object.keys(data.t).length;
    const readN = document.getElementById('labReadN'), readSub = document.getElementById('labReadSub');
    if (readN && read.size) { readN.textContent = String(read.size); if (readSub) readSub.textContent = `of ${total} guides · kept on this device only`; }
    // Not new any more: the "three places to begin" tile steps aside
    if (read.size) document.querySelector('.lab-first')?.classList.add('is-done');
    // Pick up where you left off: the last guide opened, or if that's finished, the next unread one on its shelf
    const last = getLast();
    if (last && data.t[last.slug]) {
      let slug = last.slug, kicker = 'Pick up where you left off';
      if (read.has(slug)) {
        const shelf = data.s.find(sh => sh.slugs.includes(slug));
        const next = shelf?.slugs.find(x => !read.has(x));
        if (next) { slug = next; kicker = 'Up next on that shelf'; } else kicker = 'Last opened';
      }
      const [title, mins] = data.t[slug];
      const a = document.getElementById('labLast') as HTMLAnchorElement | null;
      if (a) {
        a.href = `/learn/${slug}`;
        document.getElementById('labLastK')!.textContent = kicker;
        document.getElementById('labLastT')!.textContent = title;
        document.getElementById('labLastSub')!.textContent = `${mins} min read →`;
      }
    }
    data.s.forEach(sh => {
      const n = sh.slugs.filter(x => read.has(x)).length;
      const tile = document.querySelector<HTMLElement>(`[data-shelf="${sh.id}"]`);
      if (!tile || !n) return;
      tile.querySelector('[data-shelf-read]')!.textContent = ` · ${n} read`;
      (tile.querySelector('[data-shelf-bar]') as HTMLElement).style.width = `${Math.round(n / sh.slugs.length * 100)}%`;
    });
    tickRead();
    leanBoard();
  </script>

  <script>
    // Search: filters cards as you type; hides empty themes and shelves.
    const input = document.getElementById('hubSearch') as HTMLInputElement;
    const count = document.getElementById('hubCount')!;
    const empty = document.getElementById('hubEmpty')!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-hub-card]'));
    const text = new Map(cards.map(c => [c, (c.textContent || '').toLowerCase()]));
    const hideOnSearch = document.querySelectorAll<HTMLElement>('[data-hub-hide-on-search]');
    input.addEventListener('input', () => {
      const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      cards.forEach(c => { const ok = words.every(w => text.get(c)!.includes(w)); c.hidden = !ok; if (ok) shown++; });
      document.querySelectorAll<HTMLElement>('[data-hub-theme]').forEach(t => { t.hidden = !t.querySelector('[data-hub-card]:not([hidden])'); });
      document.querySelectorAll<HTMLElement>('[data-hub-shelf]').forEach(s => { s.hidden = !s.querySelector('[data-hub-card]:not([hidden])'); });
      hideOnSearch.forEach(el => { el.hidden = words.length > 0; });
      empty.hidden = shown > 0;
      count.textContent = words.length ? `${shown} ${shown === 1 ? 'guide' : 'guides'}` : '';
    });
  </script>
</Base>
