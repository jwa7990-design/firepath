---
/**
 * Features — a tour of every FirePath tool, grouped by the question it answers, each
 * marked Free (no account) or Pro. Keep the Free/Pro labels in step with
 * src/data/plans.ts and the page gates (Pro pages call requirePro()).
 */
import Base from '../layouts/Base.astro';
import { FREE_FEATURES, PRO_FEATURES, TRIAL_FINE_PRINT } from '../data/plans';
import '../styles/marketing.css';
import '../styles/tour.css';
import MiniPath from '../components/MiniPath.astro';

type Tool = { name: string; plan: 'Free' | 'Pro'; href: string; icon: string; line: string; points: string[] };
const GROUPS: { id: string; title: string; intro: string; tools: Tool[] }[] = [
  { id: 'plan', title: 'Your plan', intro: 'When could work become optional, and what does your whole picture look like?', tools: [
    { name: 'Freedom calculator', plan: 'Free', href: '/firepath', icon: 'flame', line: 'Your freedom date in about two minutes.',
      points: ['A real year to aim for', 'A realistic range across 2,000 possible market outcomes', 'Add your partner’s income and savings'] },
    { name: 'Your full plan', plan: 'Pro', href: '/upgrade', icon: 'bars', line: 'Your whole plan, saved, with super and a personal AI read.',
      points: ['How your savings carry you to 60, then your super takes over', 'Your partner’s super, from their own 60', 'A personal AI read on your situation'] },
    { name: 'Your Path dashboard', plan: 'Pro', href: '/upgrade', icon: 'calendar', line: 'Your plan at a glance, every time you come back.',
      points: ['Net worth and your freedom date', 'What’s changed since your last check-in', 'Weekly check-ins and milestones'] },
  ]},
  { id: 'what-if', title: 'Big decisions', intro: 'See what a big decision does to your date, in years, before you make it.', tools: [
    { name: 'What if…?', plan: 'Free', href: '/hearmeout', icon: 'spark', line: 'Run big life decisions through your own numbers.',
      points: ['Sell the house, downsize or rent vs invest', 'A lump sum, an inheritance or a redundancy payout', 'Paying off a loan, and the cost of waiting to invest'] },
    { name: 'Freedom gap', plan: 'Free', href: '/freedom-gap', icon: 'scale', line: 'See how close you are, and what part-time work and the Age Pension could add.',
      points: ['What your savings could pay you today', 'The Age Pension from 67, means-tested on assets and income', 'The hours of work a week that would close the gap'] },
    { name: 'Compound interest', plan: 'Free', href: '/compound', icon: 'bars', line: 'See what regular investing grows into.',
      points: ['Weekly, fortnightly or monthly amounts', 'How much is your money vs growth', 'What waiting five or ten years costs you'] },
  ]},
  { id: 'retirement', title: 'Will it last?', intro: 'Once you stop work, how long does the money go?', tools: [
    { name: 'Withdrawal planner', plan: 'Free', href: '/withdrawal', icon: 'shield', line: 'See if your money will last, with markets going up and down.',
      points: ['30 years across 2,000 possible market outcomes', 'What a bad run of markets early on does', 'Your income in today’s money'] },
    { name: 'Withdrawal planner, to age 95', plan: 'Pro', href: '/upgrade', icon: 'clock', line: 'The odds your own plan lasts, with the Age Pension and part-time work.',
      points: ['Odds your money lasts to 95', 'The Age Pension from 67, on your own assets', 'A slider for a few days’ work a week'] },
  ]},
  { id: 'tax', title: 'Tax and super', intro: 'The Australian rules that move your date — worked out at current ATO rates.', tools: [
    { name: 'Tax tools', plan: 'Pro', href: '/upgrade', icon: 'card', line: 'Your tax, worked out and fed into your plan.',
      points: ['Take-home pay, with HELP and the Medicare levy surcharge if they apply', 'Salary sacrifice, the yearly cap, unused cap you can carry forward, and the extra tax for high earners', 'Your offset account vs investing'] },
  ]},
  { id: 'learn', title: 'Learn', intro: 'Understand the why, in plain English.', tools: [
    { name: 'Learning Lab', plan: 'Free', href: '/learn/', icon: 'book', line: 'Plain-English guides to FIRE, investing, super and tax.',
      points: ['Real questions, answered with real numbers', 'Australian rules throughout', 'Search, or start with three short reads'] },
    { name: 'Ask FirePath', plan: 'Pro', href: '/upgrade', icon: 'chat', line: 'Ask anything about your own plan.',
      points: ['“What would paying off my car loan vs investing do to my date?”', '“What happens if I go part-time at 50?”', 'AI answers, with FirePath’s maths doing the sums'] },
    { name: 'Your reading, saved', plan: 'Pro', href: '/upgrade', icon: 'star', line: 'Keep your place and see what to read next.',
      points: ['Save articles and see what you’ve read', 'Synced across your devices', 'AI ideas for what to read next'] },
  ]},
];
const count = (p: 'Free' | 'Pro') => GROUPS.flatMap(g => g.tools).filter(t => t.plan === p).length;
---
<Base
  title="Features: all the tools, free and Pro | FirePath"
  description="Every FirePath tool in one place: your freedom date, What if…?, the Withdrawal planner, Freedom gap, Compound interest, and tax and super. Get to know your numbers free, no account needed."
  path="/features"
  active="features"
>
  {/* Shared editorial primitives. Loads before the page CSS (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <main id="main" class="hp">
    <header class="hp-hero">
      <div class="hp-wrap tour-hero">
        <div>
        <p class="hp-label mk-kicker">The tools</p>
        <h1 class="hp-h1">Every tool, in one place.</h1>
        <p class="hp-lead">Get to know your numbers free, no account needed. You just type them in. Pro saves your plan and adds super, tax and Ask FirePath.</p>
        <p class="tour-count num">{count('Free')} free tools · {count('Pro')} more with Pro</p>
        <nav class="tour-jump" aria-label="Tool groups">
          <ul class="mk-doors">
            {GROUPS.map(g => <li><a href={`#${g.id}`}>{g.title}<span class="num">{g.tools.length}</span></a></li>)}
          </ul>
        </nav>
        </div>
        <MiniPath class="tour-motif"/>
      </div>
    </header>

    <div class="tour" aria-label="All the tools" role="region">
      {GROUPS.map((g, gi) => (
        <section class:list={['hp-sec tour-group', gi % 2 === 1 && 'is-sand']} id={g.id} aria-labelledby={`${g.id}-title`}>
          <div class="hp-wrap hp-side">
            <div class="hp-side-head">
              <p class="hp-num tour-gn num" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</p>
              <h2 id={`${g.id}-title`} class="hp-h2 tour-gtitle">{g.title}</h2>
              <p class="tour-intro">{g.intro}</p>
            </div>
            <ul class="hp-side-main tour-list hp-rows">
              {g.tools.map(t => (
                <li><a href={t.href} class="tour-row" data-reveal>
                  <div class="tour-row-top">
                    <h3 class="tour-name">{t.name}</h3>
                    <span class="tour-plan" data-plan={t.plan}><span class:list={['hp-mark', t.plan === 'Free' && 'is-ink']} aria-hidden="true"></span>{t.plan === 'Free' ? 'Free · no account' : 'Pro'}</span>
                  </div>
                  <span class="tour-line">{t.line}</span>
                  <ul class="tour-pts">{t.points.map(p => <li>{p}</li>)}</ul>
                  <span class="tour-go">{t.plan === 'Free' ? 'Open the tool' : 'Part of Pro. Try it 7 days free'} <span class="hp-go" aria-hidden="true">→</span></span>
                </a></li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <section class="hp-sec is-dark tour-compare" aria-labelledby="compare-title">
      <div class="hp-wrap">
        <h2 id="compare-title" class="hp-h2 tour-compare-title">Free or Pro?</h2>
        <div class="hp-half">
          <div class="mk-plan">
            <div class="mk-plan-name"><h3>Free</h3><span class="mk-plan-tag">no account</span></div>
            <ul class="mk-feats">{FREE_FEATURES.map(f => <li>{f}</li>)}</ul>
            <div class="mk-actions"><a href="/firepath" class="mk-btn is-outline">Find my freedom date</a></div>
          </div>
          <div class="mk-plan hp-feature tour-pro">
            <div class="mk-plan-name"><h3>Pro</h3><span class="mk-plan-tag">$6 a month · 7-day free trial</span></div>
            <ul class="mk-feats">{PRO_FEATURES.map(([t]) => <li>{t}</li>)}</ul>
            <div class="mk-actions"><a href="/upgrade" class="mk-btn">Try Pro free for 7 days</a></div>
            <p class="mk-fine">{TRIAL_FINE_PRINT}</p>
          </div>
        </div>
        <a href="/pricing" class="hp-link">See pricing and questions →</a>
      </div>
    </section>
  </main>
</Base>
