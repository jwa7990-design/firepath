---
/**
 * Pricing — one decision near the top (Free vs Pro), one section of proof (real
 * results from the Pro tools), the usual questions, and a closing call to action.
 * Questions come from the shared FAQ list so they always match the FAQ page.
 */
import Base from '../layouts/Base.astro';
import '../styles/marketing.css';
import '../styles/pricing.css';
import { faqItems } from '../data/faq';

import { FREE_FEATURES as FREE, FREE_NOTE, PRO_FEATURES as PRO, TRIAL_FINE_PRINT } from '../data/plans';
const PROOF = [
  { plan: 'Free', q: 'When, realistically?', big: '10–21 yrs', text: 'In 8 of 10 possible market outcomes, you get there within this window.', eg: 'Example: $185K saved, $3,200 a month, $1.5M goal' },
  { plan: 'Free', q: 'Will my money last?', big: '94%', text: 'of 2,000 possible market outcomes, the money lasts 30 years taking 4% a year.', eg: 'Example: $1M, spending $40K a year' },
  { plan: 'Pro', q: 'What does salary sacrifice really save?', big: '$8,360', text: 'a year in tax, after your employer’s 12% counts towards the cap.', eg: 'Example: $100K salary, 2026-27 rates' },
];
const QUESTIONS = faqItems('account-needed', 'trial', 'cancel', 'advice');
---
<Base
  title="Pricing: Free vs Pro | FirePath"
  description="Get to know your numbers free, no account needed. Pro is $6 a month and adds your saved plan, super, tax and Ask FirePath. 7-day free trial, cancel any time."
  path="/pricing"
  active="pricing"
>
  {/* Shared editorial primitives. Loads before the page CSS (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <main id="main" class="hp">
    <header class="hp-hero">
      <div class="hp-wrap">
        <p class="hp-label mk-kicker">Pricing</p>
        <h1 class="hp-h1 mk-h1-wide">Free to find your date. $6 to save your plan.</h1>
        <p class="hp-lead">Get to know your numbers free, no account needed. Pro is $6 a month and adds your saved plan, super, tax and Ask FirePath.</p>
      </div>
    </header>

    <section class="hp-sec" aria-label="Plans">
      <div class="hp-wrap">
        <div class="hp-half">
          <article class="mk-plan">
            <div class="mk-plan-name"><h2>Free</h2></div>
            <p class="mk-price"><span class="mk-price-n">$0</span><span class="mk-price-per">forever</span></p>
            <p class="mk-plan-sub">{FREE_NOTE}</p>
            <div class="mk-actions"><a href="/firepath" class="mk-btn is-outline">Find my freedom date</a></div>
            <ul class="mk-feats">
              {FREE.map(f => <li>{f}</li>)}
            </ul>
          </article>

          <article class="mk-plan">
            <div class="mk-plan-name"><h2>Pro</h2><span class="mk-plan-tag">7-day free trial</span></div>
            <p class="mk-price"><span class="mk-price-n">$6</span><span class="mk-price-per">a month (AUD)</span></p>
            <p class="mk-plan-sub">Everything in Free, plus an account that remembers your numbers:</p>
            <div class="mk-actions"><a href="/upgrade" class="mk-btn">Try Pro free for 7 days</a></div>
            <p class="mk-fine">{TRIAL_FINE_PRINT}</p>
            <ul class="mk-feats">
              {PRO.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
            </ul>
          </article>
        </div>

        <ul class="price-trust">
          <li>Cancel any time from Settings</li>
          <li>Your data is never sold</li>
          <li>Current ATO rates and live RBA figures</li>
        </ul>
      </div>
    </section>

    <section class="hp-sec" aria-labelledby="proof-title">
      <div class="hp-wrap hp-side" data-reveal>
        <div class="hp-side-head">
          <p class="hp-label mk-kicker">What you’ll find out</p>
          <h2 id="proof-title" class="hp-h2 is-small">A few real examples.</h2>
          <p class="hp-body">Example results. The free tools work with any numbers you type in. Pro fills in your own and keeps them.</p>
        </div>
        <ul class="hp-side-main price-proof">
          {PROOF.map(p => (
            <li>
              <p class="price-proof-q"><span>{p.q}</span><span class="price-proof-plan">{p.plan}</span></p>
              <p class="price-proof-big num">{p.big}</p>
              <p class="price-proof-text">{p.text}</p>
              <p class="price-proof-eg">{p.eg}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="hp-sec" aria-labelledby="pq-title">
      <div class="hp-wrap hp-side" data-reveal>
        <div class="hp-side-head">
          <h2 id="pq-title" class="hp-h2 is-small">Questions before you start</h2>
          <p class="hp-body mk-prose">More answers on the <a href="/faq">questions page</a>.</p>
        </div>
        <div class="hp-side-main mk-qs">
          {QUESTIONS.map(i => (
            <details class="mk-q">
              <summary>{i.q}</summary>
              <p set:html={i.a}/>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="hp-sec price-end">
      <div class="hp-wrap mk-close" data-reveal>
        <div>
          <h2 class="hp-h2">Try Pro free for 7 days.</h2>
          <p class="hp-body">Or get to know your numbers free, no account needed.</p>
        </div>
        <div class="mk-actions">
          <a href="/upgrade" class="mk-btn">Start my free trial</a>
          <a href="/firepath" class="hp-link is-quiet">Try the free calculator first</a>
        </div>
      </div>
    </section>
  </main>
</Base>
