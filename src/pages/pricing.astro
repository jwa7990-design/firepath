---
/**
 * Pricing — one decision near the top (Free vs Pro), one section of proof (real
 * results from the Pro tools), the usual questions, and a closing call to action.
 * Questions come from the shared FAQ list so they always match the FAQ page.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/doc.css';
import '../styles/pricing.css';
import { faqItems } from '../data/faq';

const FREE = [
  'Your freedom date, in about 2 minutes',
  'What moves it: saving more, spending less',
  'Bank savings vs investing, side by side',
  'Plain-English guides in the Learning Lab',
  'No sign-up needed',
];
const PRO = [
  ['Your full plan, with a realistic range', 'Not one guess: the spread across 2,000 possible market futures.'],
  ['Will your money last?', 'The odds it lasts to 95, with the Age Pension from 67.'],
  ['Tax and super, worked out', 'Take-home, salary sacrifice, HELP, offset vs investing — at current ATO rates.'],
  ['Every "what if"', 'Sell the house, a lump sum, part-time, rent vs buy, paying off a loan.'],
  ['Built for couples', "Plan together — both incomes, both supers, couple pension rates."],
  ['Ask about your own numbers', 'Ask FirePath and personalised insights, plus progress tracking.'],
];
const PROOF = [
  { icon: 'shield', q: 'Will my money last?', big: '94%', text: 'of 2,000 market futures last 30 years at a 4% withdrawal.', eg: 'Example: $1M, spending $40K a year' },
  { icon: 'calendar', q: 'When, realistically?', big: '10–21 yrs', text: '8 in 10 market futures reach the goal within this window.', eg: 'Example: $185K saved, $3,200 a month, $1.5M goal' },
  { icon: 'scale', q: 'What does salary sacrifice really save?', big: '$8,360', text: 'a year in tax — after your employer’s 12% counts towards the cap.', eg: 'Example: $100K salary, 2026-27 rates' },
];
const QUESTIONS = faqItems('trial', 'cancel', 'data-after-cancel', 'advice');
---
<Base
  title="FirePath — Pricing: Free vs Pro"
  description="Find your freedom date free. Pro is $6 a month for the full plan — realistic ranges, tax and super, every what-if. 7-day free trial, cancel anytime."
  path="/pricing"
  active="pricing"
>
  <main id="main">
    <header class="doc-hero price-hero">
      <div class="doc-hero-inner">
        <span class="doc-eyebrow">Pricing</span>
        <h1 class="doc-title">Free to find your number. <span class="accent">$6</span> to build the plan.</h1>
        <p class="doc-lead">Start with your freedom date — free, forever. When you want the whole picture, Pro is $6 a month.</p>
      </div>
    </header>

    <section class="plans" aria-label="Plans">
      <article class="plan plan-free">
        <h2 class="plan-name">Free</h2>
        <p class="plan-price"><span class="plan-amount">$0</span><span class="plan-per">forever</span></p>
        <p class="plan-sub">No card. No catch.</p>
        <a href="/firepath" class="btn btn-quiet btn-lg btn-block">Find my freedom date <Icon name="arrow" size={16}/></a>
        <ul class="plan-list">
          {FREE.map(f => <li><span class="plan-tick"><Icon name="check" size={12} stroke={2.6}/></span>{f}</li>)}
        </ul>
      </article>

      <article class="plan plan-pro">
        <div class="plan-top">
          <h2 class="plan-name">Pro</h2>
          <span class="plan-chip">7-day free trial</span>
        </div>
        <p class="plan-price"><span class="plan-amount">$6</span><span class="plan-per">a month (AUD)</span></p>
        <p class="plan-sub">Less than a coffee. Everything in Free, plus:</p>
        <a href="/auth" class="btn btn-ember btn-lg btn-block">Try Pro free for 7 days <Icon name="arrow" size={16}/></a>
        <p class="plan-fine">Card needed to start. You won’t be charged until day 8 — cancel before then and you pay nothing.</p>
        <ul class="plan-list">
          {PRO.map(([t, d]) => <li><span class="plan-tick"><Icon name="check" size={12} stroke={2.6}/></span><span><strong>{t}</strong><span class="plan-desc">{d}</span></span></li>)}
        </ul>
      </article>
    </section>

    <p class="plan-trust">
      <span><Icon name="card" size={14}/>Cancel anytime from Settings</span>
      <span><Icon name="lock" size={14}/>Your data is never sold</span>
      <span><Icon name="bars" size={14}/>Current ATO rates and live RBA figures</span>
    </p>

    <section class="proof" aria-labelledby="proof-title">
      <div class="proof-head">
        <span class="doc-eyebrow">What $6 a month gets you</span>
        <h2 id="proof-title" class="proof-title">Real answers, not a feature list.</h2>
        <p class="proof-lead">A few results from the Pro tools — yours will use your own numbers.</p>
      </div>
      <div class="proof-grid">
        {PROOF.map(p => (
          <div class="proof-card" data-reveal>
            <span class="proof-icon"><Icon name={p.icon} size={18}/></span>
            <p class="proof-q">{p.q}</p>
            <p class="proof-big">{p.big}</p>
            <p class="proof-text">{p.text}</p>
            <p class="proof-eg">{p.eg}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="price-faq" aria-labelledby="pq-title">
      <h2 id="pq-title" class="proof-title">Questions before you start</h2>
      <div class="pq-list">
        {QUESTIONS.map(i => (
          <details class="pq-item">
            <summary>{i.q}<span class="pq-chev"><Icon name="chevron" size={13} stroke={2.4}/></span></summary>
            <p set:html={i.a}/>
          </details>
        ))}
      </div>
      <p class="pq-more">More answers on the <a href="/faq">questions page</a>.</p>
    </section>

    <section class="price-close">
      <div class="price-close-inner">
        <div>
          <h2>Try Pro free for 7 days.</h2>
          <p>Or start with the free calculator — no sign-up needed.</p>
        </div>
        <div class="price-close-actions">
          <a href="/auth" class="btn btn-ember btn-lg">Start my free trial <Icon name="arrow" size={16}/></a>
          <a href="/firepath" class="price-close-link">Try the free calculator first</a>
        </div>
      </div>
    </section>
  </main>
</Base>
