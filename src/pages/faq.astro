---
/**
 * FAQ — the question list (src/data/faq.ts) drives the page, the topic list and the
 * FAQPage data Google reads. To add a question, add it there.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/doc.css';
import '../styles/faq.css';
import { FAQ } from '../data/faq';

const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ.flatMap(c => c.items.map(i => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } }))),
};
---
<Base
  title="Common questions | FirePath"
  description="Common questions about FirePath: how the calculator works, billing, super, and your freedom number, explained in plain English."
  path="/faq"
  active="faq"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>

  <main id="main">
  <header class="doc-hero faq-hero">
    <div class="doc-hero-inner">
      <span class="doc-eyebrow">Help centre</span>
      <h1 class="doc-title">Common <span class="accent">questions</span></h1>
      <p class="doc-lead">Plain answers to the things people ask most. Can't find what you need? Email us and a real person will reply.</p>
    </div>
  </header>

  <div class="doc-body faq-body">
    <nav class="doc-toc" aria-label="Topics">
      <details class="doc-toc-mobile">
        <summary>Topics <Icon name="chevron" size={14} stroke={2.2}/></summary>
        <ol>{FAQ.map(c => <li><a href={`#${c.id}`}><span class="doc-toc-num">{c.items.length}</span>{c.title}</a></li>)}</ol>
      </details>
      <div class="doc-toc-desktop">
        <p class="doc-toc-label">Topics</p>
        <ol>{FAQ.map(c => <li><a href={`#${c.id}`} data-toc={c.id}><span class="doc-toc-num">{c.items.length}</span>{c.title}</a></li>)}</ol>
      </div>
    </nav>

    <div class="doc-content faq-content">
      {FAQ.map(c => (
        <section class="faq-group" id={c.id} data-doc-section aria-labelledby={`${c.id}-title`}>
          <div class="faq-group-head">
            <span class="faq-group-icon"><Icon name={c.icon} size={18}/></span>
            <h2 id={`${c.id}-title`}>{c.title}</h2>
            <span class="faq-group-count">{c.items.length} questions</span>
          </div>
          <div class="faq-list" data-reveal>
            {c.items.map(i => (
              <div class="faq-item" id={`q-${i.id}`}>
                <h3>
                  <button class="faq-q" type="button" aria-expanded="false" aria-controls={`a-${i.id}`}>
                    <span>{i.q}</span>
                    <span class="faq-chev"><Icon name="chevron" size={13} stroke={2.4}/></span>
                  </button>
                </h3>
                <div class="faq-a" id={`a-${i.id}`} role="region" aria-label={i.q}>
                  <div class="faq-a-inner"><p set:html={i.a}/></div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}


      <aside class="doc-contact">
        <span class="doc-contact-icon"><Icon name="mail" size={20}/></span>
        <div>
          <h2>Still have a question?</h2>
          <p>FirePath is built by one person. Email us and you'll get a real reply, usually within a day.</p>
        </div>
        <a href="mailto:hello@firepath.pro" class="btn btn-ember">Email hello@firepath.pro</a>
      </aside>
    </div>
  </div>
  </main>

  <script is:inline src="/js/quick-feedback-widget.js"></script>
  <script>
    import { followSections } from '../scripts/toc';
    const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('open', open);
      item.querySelector('.faq-q')?.setAttribute('aria-expanded', String(open));
    };

    // Open / close. The address updates so an answer can be shared directly.
    items.forEach(item => item.querySelector('.faq-q')?.addEventListener('click', () => {
      const open = !item.classList.contains('open');
      setOpen(item, open);
      if (open) history.replaceState(null, '', `#${item.id}`);
    }));

    // Arriving on a shared link (#q-cancel) opens that answer.
    const target = location.hash.startsWith('#q-') ? document.getElementById(location.hash.slice(1)) : null;
    if (target) { setOpen(target, true); requestAnimationFrame(() => target.scrollIntoView({ block: 'center' })); }


    // Topic list follows your scrolling.
    followSections();
    // Close the phone topics menu after choosing one.
    document.querySelectorAll('.doc-toc-mobile a').forEach(a => a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
  </script>
</Base>
