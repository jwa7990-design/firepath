---
/**
 * FAQ — the question list (src/data/faq.ts) drives the page, the topic list and the
 * FAQPage data Google reads. To add a question, add it there.
 */
import Base from '../layouts/Base.astro';
import '../styles/marketing.css';
import '../styles/faq.css';
import { FAQ } from '../data/faq';

const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ.flatMap(c => c.items.map(i => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } }))),
};
---
<Base
  title="Common questions | FirePath"
  description="Common questions about FirePath: how the calculator works, billing, super, and your freedom number, explained in plain English."
  path="/faq"
  active="faq"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>

  {/* Shared editorial primitives. Loads before the page CSS (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>

  <main id="main" class="hp">
  <header class="hp-hero">
    <div class="hp-wrap faq-hero">
      <div>
        <p class="hp-label mk-kicker">Help centre</p>
        <h1 class="hp-h1">Common questions</h1>
        <p class="hp-lead">Plain answers to the things people ask most. Can't find what you need? Email us and a real person will reply.</p>
      </div>
      <nav class="faq-toc-desktop" aria-label="Topics">
        <p class="hp-label is-ink">Topics</p>
        <ol class="hp-rows">{FAQ.map((c, ci) => <li><a href={`#${c.id}`} data-toc={c.id}><span class="faq-toc-n num" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span><span class="faq-toc-t">{c.title}</span><span class="faq-toc-num num">{c.items.length}</span></a></li>)}</ol>
      </nav>
    </div>
  </header>

  <nav class="faq-toc" aria-label="Topics">
    <details class="doc-toc-mobile faq-toc-mobile">
      <summary><span class="hp-wrap faq-toc-bar">Topics <span class="faq-toc-chev" aria-hidden="true">+</span></span></summary>
      <ol class="hp-wrap">{FAQ.map(c => <li><a href={`#${c.id}`}>{c.title}<span class="faq-toc-num num">{c.items.length}</span></a></li>)}</ol>
    </details>
  </nav>

  <div class="faq-content">
    {FAQ.map((c, ci) => (
      <section class:list={['hp-sec faq-group', ci % 2 === 1 && 'is-sand']} id={c.id} data-doc-section aria-labelledby={`${c.id}-title`}>
        <div class="hp-wrap hp-side">
          <div class="hp-side-head faq-group-head">
            <p class="faq-gn num" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</p>
            <h2 id={`${c.id}-title`} class="hp-h2">{c.title}</h2>
            <span class="faq-group-count num">{c.items.length} questions</span>
          </div>
          <div class="hp-side-main faq-list" data-reveal>
            {c.items.map(i => (
              <div class="faq-item" id={`q-${i.id}`}>
                <h3>
                  <button class="faq-q" type="button" aria-expanded="false" aria-controls={`a-${i.id}`}>
                    <span>{i.q}</span>
                    <span class="faq-chev" aria-hidden="true">+</span>
                  </button>
                </h3>
                <div class="faq-a" id={`a-${i.id}`} role="region" aria-label={i.q}>
                  <div class="faq-a-inner"><p set:html={i.a}/></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="hp-sec is-dark faq-contact" aria-labelledby="faq-contact-title">
    <div class="hp-wrap mk-close">
      <div>
        <h2 id="faq-contact-title" class="hp-h2 faq-contact-title">Still have a question?</h2>
        <p class="hp-body">FirePath is built by one person. Email us and you'll get a real reply, usually within a day.</p>
      </div>
      <div class="mk-actions"><a href="mailto:hello@firepath.pro" class="mk-btn">Email hello@firepath.pro</a></div>
    </div>
  </section>
  </main>

  <script is:inline src="/js/quick-feedback-widget.js"></script>
  <script>
    import { followSections } from '../scripts/toc';
    const items = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('open', open);
      item.querySelector('.faq-q')?.setAttribute('aria-expanded', String(open));
    };

    // Open / close. The address updates so an answer can be shared directly.
    items.forEach(item => item.querySelector('.faq-q')?.addEventListener('click', () => {
      const open = !item.classList.contains('open');
      setOpen(item, open);
      if (open) history.replaceState(null, '', `#${item.id}`);
    }));

    // Arriving on a shared link (#q-cancel) opens that answer.
    const target = location.hash.startsWith('#q-') ? document.getElementById(location.hash.slice(1)) : null;
    if (target) { setOpen(target, true); requestAnimationFrame(() => target.scrollIntoView({ block: 'center' })); }


    // Topic list follows your scrolling.
    followSections();
    // Close the phone topics menu after choosing one.
    document.querySelectorAll('.doc-toc-mobile a').forEach(a => a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
  </script>
</Base>
