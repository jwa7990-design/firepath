---
/**
 * Upgrade — where every "Pro needed" path lands. Accounts are part of Pro, so this
 * explains that and starts the trial: signed in → Stripe checkout (upgradeToPro in
 * js/auth.js); signed out → create an account first. Also handles coming back from
 * Stripe (?upgraded=true: waits for Pro to land) and cancelling (?cancelled=true).
 */
import Base from '../layouts/Base.astro';
import { PRO_FEATURES, PRO_PRICE, TRIAL_FINE_PRINT } from '../data/plans';
import '../styles/marketing.css';
import '../styles/upgrade.css';
---
<Base noindex title="Start your 7-day free Pro trial | FirePath" description="FirePath accounts come with Pro. Start your 7-day free trial: your saved plan, super, tax and Ask FirePath." path="/upgrade">
  <script slot="head" is:inline src="/js/auth.js"></script>
  {/* Shared editorial primitives. Loads before the page CSS (Astro adds bundled CSS after the head slot). */}
  <link slot="head" rel="stylesheet" href="/css/fp-editorial.css"/>
  <main id="main" class="hp up">
    <section class="up-sec" aria-labelledby="up-title">
      <div class="hp-wrap hp-two">
        <div class="up-main">
          <div class="up-status up-waiting" id="upWaiting" role="status" hidden>
            <span class="up-spinner" aria-hidden="true"></span>
            <div><strong>Setting up your Pro account…</strong><span id="upWaitingText">This usually takes a few seconds.</span></div>
          </div>
          <div class="up-status up-note" id="upCancelled" hidden>
            <span>No problem — you haven’t been charged. You can start your trial whenever you’re ready.</span>
          </div>

          <p class="hp-label mk-kicker">FirePath Pro</p>
          <h1 id="up-title" class="hp-h1 up-title">Accounts come with <span class="accent">Pro</span>.</h1>
          <p class="hp-lead" id="upLead">Get to know your numbers free, no account needed. An account comes with Pro. It saves your plan and adds super, tax and Ask FirePath.</p>

          <div class="up-price">
            <p class="mk-price"><span class="mk-price-n hp-big is-ember">{PRO_PRICE.amount}</span><span class="mk-price-per">{PRO_PRICE.per} · {PRO_PRICE.trialDays}-day free trial</span></p>
            <div class="mk-actions">
              <button class="mk-btn" id="upStart" type="button">Start my 7-day free trial</button>
            </div>
            <p class="mk-fine">{TRIAL_FINE_PRINT}</p>
          </div>

          <div class="up-foot mk-prose">
            <a href="/firepath">Keep using the free tools</a>
            <span id="upWho"></span>
          </div>
        </div>

        <figure class="hp-panel is-dark up-fig">
          <figcaption class="hp-label is-ink up-fig-tag">What Pro adds</figcaption>
          <ul class="mk-feats">
            {PRO_FEATURES.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
          </ul>
        </figure>
      </div>
    </section>
  </main>

  <script is:inline>
  (function () {
    var q = new URLSearchParams(location.search);
    var signedIn = typeof isLoggedIn === 'function' && isLoggedIn();
    var btn = document.getElementById('upStart');
    var who = document.getElementById('upWho');

    if (signedIn) {
      var email = getEmail();
      who.textContent = email ? 'Signed in as ' + email + ' · ' : '';
      const out = document.createElement('a'); out.href = '/auth?action=signout'; out.textContent = 'Sign out';
      who.appendChild(out);
      btn.addEventListener('click', function () { btn.disabled = true; btn.textContent = 'Opening secure checkout…'; upgradeToPro(); });
    } else {
      document.getElementById('up-title').innerHTML = 'Save your plan with <span class="accent">Pro</span>.';
      document.getElementById('upLead').textContent = 'Get to know your numbers free, no account needed. An account comes with Pro. It saves your plan and adds super, tax and Ask FirePath.';
      who.innerHTML = 'Already a member? <a href="/auth">Sign in</a>';
      btn.addEventListener('click', function () { location.href = '/auth?start=trial'; });
    }

    if (q.get('cancelled') === 'true') document.getElementById('upCancelled').hidden = false;

    // Back from Stripe: Pro is switched on by a message from Stripe that can take a few
    // seconds. Wait for it, then go to Journey.
    if (q.get('upgraded') === 'true' && signedIn) {
      var waiting = document.getElementById('upWaiting');
      waiting.hidden = false; btn.hidden = true;
      var tries = 0;
      (function poll() {
        checkProStatus().then(function (pro) {
          if (pro) { location.href = '/journey?upgraded=true'; return; }
          if (++tries < 20) { setTimeout(poll, 2000); return; }
          document.getElementById('upWaitingText').innerHTML = 'Your payment went through, but Pro is taking longer than usual to switch on. Refresh in a minute, or email <a href="mailto:hello@firepath.pro">hello@firepath.pro</a> and we’ll sort it.';
          waiting.querySelector('.up-spinner').hidden = true;
        });
      })();
    }
  })();
  </script>
</Base>
