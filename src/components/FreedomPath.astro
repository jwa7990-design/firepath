---
/**
 * The homepage's live calculator: five inputs, the freedom age and its range, the freedom
 * number and three what-if options. Markup only. The page's headline goes in the "intro"
 * slot, above the inputs (left column on wide screens; the result panel sits right).
 * public/js/home-path.js does the maths (FirePathEngine.freedomPlan + freedomRange); the
 * picture of the path is the timeline section below the calculator.
 * The example person below is also the fallback the script resets to.
 */
const EXAMPLE = { age: 32, savings: 60000, super: 50000, monthly: 2500, spend: 50000 };
const fmt = (n: number) => n.toLocaleString('en-AU');
const k = (n: number) => `$${Math.round(n / 1000)}k`;
// "32 · $60k saved · $50k super · $2,500 a month · $50k a year"
const exampleLine = `${EXAMPLE.age} · ${k(EXAMPLE.savings)} saved · ${k(EXAMPLE.super)} super · $${fmt(EXAMPLE.monthly)} a month · ${k(EXAMPLE.spend)} a year`;
const FIELDS = [
  { id: 'hpAge', key: 'age', label: 'Age', money: false, value: String(EXAMPLE.age), unit: '' },
  { id: 'hpSavings', key: 'savings', label: 'Savings and investments', hint: 'outside super', money: true, value: fmt(EXAMPLE.savings), unit: '' },
  { id: 'hpSuper', key: 'super', label: 'Super', money: true, value: fmt(EXAMPLE.super), unit: '' },
  { id: 'hpMonthly', key: 'monthly', label: 'Saved each month', money: true, value: fmt(EXAMPLE.monthly), unit: '' },
  { id: 'hpSpend', key: 'spend', label: 'Yearly spending', money: true, value: fmt(EXAMPLE.spend), unit: 'a year' },
];
---
<div class="hp-calc" id="hpCalc" data-example={JSON.stringify(EXAMPLE)}>
  <div class="hp-calc-side">
  <slot name="intro"/>
  <h2 class="hp-calc-q" id="hpCalcQ">When could you stop working?</h2>
  <p class="hp-calc-sub"><span class="hp-wide">Type a few numbers to see the year work could become optional, and the path to get there. </span>Free, no account needed.</p>
  <form class="hp-inputs" id="hpForm" novalidate aria-labelledby="hpCalcQ" aria-describedby="hpWho">
    <div class="hp-who">
      <p class="hp-who-label" id="hpWho" aria-live="polite" aria-atomic="true">
        <span class="hp-who-ex" id="hpWhoEx"><span class="hp-who-tag">Example person</span> <span class="hp-who-text">{exampleLine}</span></span>
        <span class="hp-who-you" id="hpWhoYou"></span>
      </p>
      <button type="button" class="hp-reset" id="hpReset" hidden>Reset to example</button>
    </div>
    <div class="hp-fields">
      {FIELDS.map(f => (
        <div class={`hp-field hp-field-${f.key}`}>
          <label for={f.id}>{f.label}{f.hint && <span class="hp-hint"> {f.hint}</span>}</label>
          <div class={f.money ? 'hp-box is-money' : 'hp-box'}>
            {f.money && <span aria-hidden="true">$</span>}
            <input id={f.id} name={f.key} value={f.value} inputmode={f.money ? 'decimal' : 'numeric'} autocomplete="off" spellcheck="false"/>
          </div>
        </div>
      ))}
    </div>
    <p class="hp-today">All in today’s dollars.</p>
  </form>
  </div>

  <div class="hp-out-col">
  <div class="hp-out">
    <div class="hp-result" id="hpResult">
      <!-- No age in the markup: the engine works it out on load (a built-in number could disagree with it). -->
      <p class="hp-big" id="hpBig">Work could become optional at <strong class="hp-age num" id="hpAgeOut">–</strong></p>
      <p class="hp-when num" id="hpWhen">Working it out from the example numbers…</p>
      <p class="hp-range num" id="hpRange"></p>
      <p class="hp-fnum num">Your freedom number is about <strong data-hp-number>$1,250,000</strong>: <span class="hp-nw">25 × <span data-hp-spend>$50,000</span></span>, your yearly spending. Stopping before 60, FirePath aims a bit higher.</p>
      <p class="hp-est">An estimate, not a promise. <a href="/faq#q-accurate">How accurate is this?</a></p>
    </div>


    <div class="hp-whatif" id="hpWhatIf">
      <p class="hp-whatif-head">What-ifs to explore <span>Tap one to see what it changes</span></p>
      <div class="hp-chips" role="group" aria-label="What-if options">
        <button type="button" class="hp-chip" data-chip="week100" aria-pressed="false">+$100 a week <span class="hp-chip-to" aria-hidden="true">→</span> <strong>–</strong></button>
        <button type="button" class="hp-chip" data-chip="spend10" aria-pressed="false">Spend 10% less <span class="hp-chip-to" aria-hidden="true">→</span> <strong>–</strong></button>
        <button type="button" class="hp-chip" data-chip="both" aria-pressed="false">Both <span class="hp-chip-to" aria-hidden="true">→</span> <strong>–</strong></button>
      </div>
      <p class="hp-preview" id="hpPreview" aria-live="polite"></p>
    </div>

    <div class="hp-actions">
      <a href="/firepath" class="hp-btn">Add more detail</a>
      <p class="hp-btn-note">Your pay, debts, home and a partner. Free, no account.</p>
    </div>
  </div>
  </div>
  <!-- Below the panel, not in it: keeps the panel short enough to stay in view beside the inputs -->
  <p class="hp-fine">General information, not advice. Assumes 7% growth a year after inflation, less tax, and less super fund fees inside super. Leaves out future employer super. <a href="/assumptions">How we calculate →</a></p>
</div>
